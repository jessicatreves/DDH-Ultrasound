# 1. Input the exact data from your 27-study table
ddh_data <- data.frame(
  Study = c(
    "Alshameeri et al. (2014)", "Antoniak et al. (2021)", "Brusalis et al. (2017)", "Donnelly et al. (2015)", "Fludder et al. (2023)", "Jones et al. (2006)", "Haertle et al. (2023)", "Imrie et al. (2010)", "Jaiswal et al. (2010)", "Jiang et al. (2026)", "Ki et al. (2025)", "Kim et al. (2022)", "Laborie et al. (2013)", "Kohler and Hell (2003)", "Morris et al. (2019)", "Morris et al. (2021)", "Mulrain et al. (2020)", "Olsen et al. (2018)", "Osarumwense et al. (2007)", "Pan et al. (2022)", "Rafique et al. (2007)", "Roovers et al. (2005)", "Rosendahl et al. (1994)", "Schmitt et al. (2018)", "Tafazal and Flowers (2015)", "Vane et al. (2005)", "Walton et al. (2022)"
  ),
  D1 = c("Green", "Green", "Green", "Green X", "Green", "Green X", "Green", "Yellow", "Green", "Green", "Green", "Green", "Green", "Green", "Yellow", "Green", "Green", "Green", "Green", "Green", "Green", "Green", "Green", "Green", "Green", "Yellow", "Green"),
  D2 = c("Green", "Yellow", "Yellow", "Yellow", "Green X", "Green", "Green", "Yellow", "Yellow", "Green", "Green", "Yellow", "Yellow", "Green", "Yellow", "Yellow", "Yellow", "Green", "Yellow", "Yellow", "Green", "Green", "Green", "Yellow", "Yellow", "Yellow", "Yellow"),
  D3 = c("Yellow", "Green", "Green", "Yellow", "Yellow", "Green X", "Yellow", "Yellow", "Green", "Green", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Green", "Yellow", "Yellow", "Yellow", "Yellow*", "Green", "Yellow", "Yellow", "Yellow", "Green", "Yellow", "Yellow"),
  D4 = c("Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Green", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Purple"),
  D5 = c("Yellow", "Yellow", "Yellow", "Yellow", "Green", "Green", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Green", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Green", "Yellow", "Green", "Yellow", "Yellow", "Yellow", "Yellow"),
  D6 = c("Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Yellow", "Green", "Yellow", "Yellow", "Yellow", "Yellow", "Green", "Yellow", "Yellow", "Yellow", "Yellow", "Green", "Yellow", "Yellow", "Yellow", "Yellow"),
  D7 = c("Yellow", "Green", "Yellow", "Yellow", "Yellow", "Green", "Yellow", "Green", "Yellow", "Green", "Green", "Green", "Green", "Yellow", "Green", "Yellow", "Yellow", "Yellow", "Green", "Yellow", "Yellow", "Yellow", "Green", "Green", "Green", "Green", "Yellow"),
  D8 = c("Green", "Green", "Green", "Green X", "Green", "Green", "Yellow", "Green", "Green", "Green", "Yellow", "Yellow", "Green", "Yellow", "Green", "Green", "Green", "Green", "Green", "Green", "Green", "Green X**", "Green", "Green", "Yellow", "Yellow", "Green"),
  check.names = FALSE
)

# 2. Define domain labels for clear stand-alone presentation
domain_labels <- c(
  "D1" = "D1: Alpha angle",
  "D2" = "D2: Beta angle",
  "D3" = "D3: Femoral head coverage",
  "D4" = "D4: Straight iliac line",
  "D5" = "D5: Acetabular morphology",
  "D6" = "D6: Lateral position",
  "D7" = "D7: Dynamic ultrasound",
  "D8" = "D8: Clinical stability"
)

# 3. Reshape data, separate findings from colors, and calculate aggregate percentages
ddh_summary <- ddh_data %>%
  pivot_longer(
    cols = starts_with("D"),
    names_to = "Domain",
    values_to = "Status"
  ) %>%
  mutate(
    # Map to the 3-Tier color structure (plus Purple for pending review)
    Base_Color = case_when(
      grepl("Green", Status) ~ "Adequate (Reported)",
      grepl("Yellow", Status) ~ "Inadequate (Not reported)",
      grepl("Red", Status) ~ "Pathological (Ignored)",
      grepl("Purple", Status) ~ "Pending Review"
    ),
    # Extract specific symbols for the geom_text overlay
    Symbol = case_when(
      grepl("X\\*\\*", Status) ~ "X**",
      grepl("X", Status) ~ "X",
      grepl("\\*", Status) ~ "*",
      TRUE ~ ""
    )
  ) %>%
  group_by(Domain, Base_Color, Symbol) %>%
  summarise(Count = n(), .groups = "drop") %>%
  group_by(Domain) %>%
  mutate(
    Percentage = Count / sum(Count),
    Domain_Label = factor(domain_labels[Domain], levels = rev(domain_labels)),
    Base_Color = factor(Base_Color, levels = c("Adequate (Reported)", "Inadequate (Not reported)", "Pending Review", "Pathological (Ignored)"))
  )

# 4. Define publication color palette 
status_colors <- c(
  "Adequate (Reported)"       = "#53b848", # Green
  "Inadequate (Not reported)" = "#fcd116", # Yellow
  "Pending Review"            = "#9b59b6", # Purple
  "Pathological (Ignored)"    = "#cc3333"  # Red
)

# 5. Generate the Cochrane-style summary bar chart
p_bar <- ggplot(ddh_summary, aes(x = Percentage, y = Domain_Label, fill = Base_Color)) +
  # Draw stacked horizontal bars 
  geom_bar(stat = "identity", position = "fill", color = "#333333", linewidth = 0.3, width = 0.7) +
  
  # Overlay symbols for abnormal or nuanced findings
  geom_text(aes(label = Symbol), position = position_fill(vjust = 0.5), size = 3.5, fontface = "bold", color = "#111111") +
  
  # Apply matching colors
  scale_fill_manual(
    values = status_colors,
    name = "Reporting Status",
    drop = FALSE
  ) +
  
  # Format x-axis as percentages (0% to 100%)
  scale_x_continuous(
    labels = percent_format(accuracy = 1),
    expand = expansion(mult = c(0, 0.02))
  ) +
  
  # Clean academic labeling with requested footnotes
  labs(
    title = "Overall Reporting Frequency of Diagnostic Screening Criteria",
    subtitle = "Aggregate proportion across all included studies (n = 27)",
    x = "Percentage of Studies",
    y = NULL,
    caption = "Symbols: [X] Measured but clearly abnormal. [*] Sufficient femoral head coverage noted for 1 of 2 patients. [**] n=19 had abnormal clinical results."
  ) +
  
  # Academic minimalist theme styling
  theme_minimal(base_size = 11, base_family = "sans") +
  theme(
    # Clean gridlines
    panel.grid.major.y = element_blank(),
    panel.grid.minor.y = element_blank(),
    panel.grid.major.x = element_line(color = "#e5e5e5", linewidth = 0.5),
    panel.grid.minor.x = element_blank(),
    
    # Typography and axis formatting
    plot.title = element_text(face = "bold", size = 13, hjust = 0, margin = margin(b = 4)),
    plot.subtitle = element_text(size = 10, color = "#555555", hjust = 0, margin = margin(b = 15)),
    axis.text.y = element_text(face = "bold", size = 10, color = "#111111"),
    axis.text.x = element_text(size = 9.5, color = "#333333"),
    axis.title.x = element_text(face = "bold", size = 10.5, margin = margin(t = 10)),
    
    # Caption formatting for footnotes
    plot.caption = element_text(size = 9, color = "#444444", hjust = 0, margin = margin(t = 15)),
    plot.caption.position = "plot",
    
    # Legend placement
    legend.position = "bottom",
    legend.title = element_text(face = "bold", size = 10),
    legend.text = element_text(size = 9.5),
    legend.margin = margin(t = 10, r = 0, b = 0, l = 0),
    
    # Margins
    plot.margin = margin(t = 15, r = 20, b = 15, l = 15)
  )

# Display the plot
print(p_bar)

