# 3. Generate the publication-ready summary of findings table
summary_table <- summary_data %>%
  gt() %>%
  
  # Apply clean academic styling
  tab_options(
    table.border.top.color = "black",
    table.border.top.width = px(2),
    table.border.bottom.color = "black",
    table.border.bottom.width = px(2),
    column_labels.border.top.color = "black",
    column_labels.border.top.width = px(1),
    column_labels.border.bottom.color = "black",
    column_labels.border.bottom.width = px(1),
    table_body.hlines.style = "none",
    table.font.size = px(11),
    data_row.padding = px(4)
  ) %>%
  
  # Align Author column left, all clinical data columns center
  cols_align(
    align = "left",
    columns = 1
  ) %>%
  cols_align(
    align = "center",
    columns = -1
  ) %>%
  
  # Add footnotes for abbreviations and specific formatting rules
  tab_source_note(
    source_note = md("NR = Not reported. US = Ultrasound.<br>\\* Mean (range)<br>\\*\\* Median (range)<br>Units of time were converted where possible (e.g., 1 month = 4.3 weeks).")
  )

# Display the table
print(summary_table)

